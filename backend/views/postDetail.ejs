<!DOCTYPE html>
<html lang="en">
<%- include('includes/head') %>
<body>
  <%- include('includes/header') %>

  <main>
    <h2><%= post.title %></h2>
    <p>
      <strong>By:</strong> <%= post.author %> |
      <strong>Company:</strong>
      <a href="/company/<%= post.company_id %>"><%= post.company_name %></a>
    </p>
    <p><%= post.content %></p>
    <p>Rating: <%= post.rating %>/5</p>

    <!-- Voting -->
    <form action="/vote/post/<%= post.post_id %>" method="POST" style="display:inline;">
      <input type="hidden" name="vote_type" value="up">
      <button type="submit">👍</button>
    </form>
    <form action="/vote/post/<%= post.post_id %>" method="POST" style="display:inline;">
      <input type="hidden" name="vote_type" value="down">
      <button type="submit">👎</button>
    </form>

    <!-- Flag -->
    <p><a href="/flag/<%= post.post_id %>">🚩 Flag this post</a></p>

    <% if (response) { %>
      <div class="company-response">
        <h4>Company Response:</h4>
        <p><%= response.content %></p>
      </div>
    <% } %>

    <!-- Comments -->
    <section>
      <h3>Comments</h3>
      <% if (comments.length > 0) { %>
        <% comments.forEach(c => { %>
          <div class="comment">
            <p><strong><%= c.username %></strong>: <%= c.content %></p>
          </div>
        <% }) %>
      <% } else { %>
        <p>No comments yet.</p>
      <% } %>

      <!-- Add a Comment -->
      <form action="/comment/<%= post.post_id %>" method="POST">
        <textarea name="content" rows="3" required placeholder="Write your comment..."></textarea><br>
        <button type="submit">Submit Comment</button>
      </form>
    </section>

    <!-- Company Response Form -->
    <% if (user && user.role === 'company' && !response) { %>
      <section>
        <h3>Write a Response</h3>
        <form action="/respond/<%= post.post_id %>" method="POST">
          <textarea name="content" rows="3" required placeholder="Write your response..."></textarea><br>
          <button type="submit">Submit Response</button>
        </form>
      </section>
    <% } %>
  </main>

  <%- include('includes/footer') %>
</body>
</html>
